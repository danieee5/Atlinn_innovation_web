# Full site URL, no trailing slash. Set this to the real deployment URL
# (e.g. https://atlinn-web.vercel.app, or the final custom domain) so that
# canonical tags, sitemap.xml, and OpenGraph/Twitter cards resolve correctly.
NEXT_PUBLIC_SITE_URL=https://www.atlinninnovations.com

# Google Tag Manager container ID (wraps GA4 + Google Ads conversion tags)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta (Facebook/Instagram) Pixel ID for Meta Ads
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
